{
  "name": "jsondeck",
  "version": "0.1.2",
  "description": "Turn JSON plus a small config into a compact dashboard: tables with filters, sort, grouping and saved views, charts, stat tiles and linked tables. One script tag from a CDN, or an ES module for React apps.",
  "keywords": [
    "json",
    "dashboard",
    "data-table",
    "datagrid",
    "table",
    "react",
    "charts",
    "viewer",
    "cdn",
    "admin",
    "inventory",
    "filters"
  ],
  "license": "MIT",
  "author": "Aman Bansal (khanakia)",
  "homepage": "https://github.com/khanakia/jsondeck#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khanakia/jsondeck.git"
  },
  "bugs": {
    "url": "https://github.com/khanakia/jsondeck/issues"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/jsondeck.js",
  "module": "./dist/jsondeck.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/jsondeck.mjs",
      "default": "./dist/jsondeck.js"
    },
    "./jsondeck.css": "./dist/jsondeck.css",
    "./full": "./dist/jsondeck.full.js",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css",
    "./dist/jsondeck.full.js"
  ],
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 128",
    "safari >= 16.4"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/gen-externals.mjs --check && vite build -c vite.full.config.ts && vite build && vite build -c vite.loader.config.ts && vite build -c vite.esm.config.ts && node scripts/make-full.mjs && rm -rf dist/types && tsc -p tsconfig.build.json && node scripts/fix-dts.mjs",
    "gen:externals": "node scripts/gen-externals.mjs",
    "build:full": "vite build -c vite.full.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.examples.json && node scripts/expect-type-error.mjs",
    "build:viz": "vite build -c src/viz/vite.viz.config.ts",
    "analyze": "vite build -c vite.analyze.config.ts",
    "size": "node scripts/size.mjs",
    "verify": "scripts/verify-all.sh",
    "release": "node scripts/release.mjs",
    "release:dry": "node scripts/release.mjs --dry"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.68.0",
    "react-day-picker": "^10.0.2"
  },
  "devDependencies": {
    "@babel/parser": "^8.1.0",
    "@tailwindcss/vite": "^4.3.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "magic-string": "^1.4.5",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rollup-plugin-visualizer": "^7.1.2",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.4",
    "terser": "^5.51.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
